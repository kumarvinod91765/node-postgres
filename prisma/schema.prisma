generator client {
  provider = "prisma-client-js"
  // remove output unless you specifically need custom path
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  role      String?
  status    Boolean?
  createdAt DateTime @default(now())
}

model Category {
  id            Int    @id @default(autoincrement())
  name          String
  description   String
  status        Boolean?
  createdAt     DateTime @default(now())

  // 🔗 One-to-many
  products    Product[]
}

model Product {
  id         Int      @id @default(autoincrement())
  name       String
  price      Float
  stock      Int
  status     Boolean

  // 🔗 Relation
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}